[Unit]
Description=EGNooz 10:00am Melbourne unpublished reminder (never publishes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/egnooz/egnooz
EnvironmentFile=/home/egnooz/.config/egnooz/egnooz.env
Environment=EGNOOZ_ROOT=/home/egnooz/egnooz
ExecStart=/home/egnooz/egnooz/.venv/bin/egnooz remind
Nice=10
