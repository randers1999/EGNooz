# Crontab for user krystalbbs on krystalbbs.net
# Use this if you would rather not enable systemd timers.
# Install: crontab -u krystalbbs deploy/cron/egnooz.crontab
#
# Ingest still never publishes. The 10:00 job only emails Tom.

CRON_TZ=Australia/Melbourne
SHELL=/bin/bash
PATH=/home/krystalbbs/egnooz/.venv/bin:/usr/bin:/bin

0 5 * * * cd /home/krystalbbs/egnooz && /home/krystalbbs/egnooz/.venv/bin/egnooz ingest >> /home/krystalbbs/egnooz-data/ingest.log 2>&1
0 10 * * * cd /home/krystalbbs/egnooz && /home/krystalbbs/egnooz/.venv/bin/egnooz remind >> /home/krystalbbs/egnooz-data/reminder.log 2>&1
