[Unit]
Description=EGNooz 10:00am Melbourne unpublished reminder (never publishes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=krystalbbs
Group=krystalbbs
WorkingDirectory=/home/krystalbbs/egnooz
EnvironmentFile=/home/krystalbbs/.config/egnooz/egnooz.env
Environment=EGNOOZ_ROOT=/home/krystalbbs/egnooz
ExecStart=/home/krystalbbs/egnooz/.venv/bin/egnooz remind
Nice=10
NoNewPrivileges=true
PrivateTmp=true
