# Copy to /home/egnooz/.config/egnooz/egnooz.env (chmod 600) or to .env in the clone.
# App Unix user is egnooz on krystalbbs.net. Never commit the filled file.
# systemd reads it via EnvironmentFile.

EGNOOZ_TZ=Australia/Melbourne
EGNOOZ_ROOT=/home/egnooz/egnooz
EGNOOZ_DATA_DIR=/home/egnooz/egnooz-data

# Review app bind. Keep 127.0.0.1 if nginx/caddy terminates TLS.
# Use 0.0.0.0 only on a firewalled VPS while you have no reverse proxy.
EGNOOZ_BIND=127.0.0.1
EGNOOZ_PORT=8080

# Public URL of this app, used in reminder and draft-ready emails.
# VPS hostname is krystalbbs.net. If that host already serves another site,
# put EGNooz behind a path (https://krystalbbs.net/egnooz) and change this.
REVIEW_BASE_URL=https://krystalbbs.net

# Long random string for Flask sessions. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Password for the phone review page. Do not put this on a command line.
REVIEW_PASSWORD=

# True when REVIEW_BASE_URL is https://krystalbbs.net (or another https URL).
SESSION_COOKIE_SECURE=true

# Tom's address: draft-ready mail, 10:00am reminder, and the prototype edition email.
TOM_EMAIL=

# Resend. Leave the key empty to run ingest/review without sending mail.
# Create the key in Resend; never paste it into git or chat.
RESEND_API_KEY=
RESEND_FROM=

# After Publish, email TOM_EMAIL. Optionally also comma-separated testers.
# Leave empty for the prototype (Tom only). Never auto-filled from a scrape.
SUBSCRIBER_EMAILS=

# Ingest sends Tom "draft ready" after the 5:00am job. Reminder is separate.
SEND_DRAFT_READY_EMAIL=true
